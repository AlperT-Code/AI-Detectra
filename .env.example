# Groq API anahtarinizi buraya yazin ve bu dosyayi ".env" olarak kaydedin.
# Anahtari su adresten ucretsiz alabilirsiniz: https://console.groq.com/keys
GROQ_API_KEY=gsk_buraya_anahtarinizi_yazin

# Istege bagli: kullanilacak modeller
GROQ_TEXT_MODEL=llama-3.3-70b-versatile
GROQ_VISION_MODEL=qwen/qwen3.6-27b

# Istege bagli: sunucu portu
PORT=3000
